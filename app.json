{
  "expo": {
    "name": "Wanla",
    "slug": "wanla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wanla.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.wanla.app",
      "adaptiveIcon": {
        "backgroundColor": "#C6F432",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ใช้เพื่อเลือกรูปสลิปโอนเงินมาให้แอปอ่านยอดเงิน",
          "cameraPermission": "ใช้เพื่อถ่ายรูปสลิปโอนเงินให้แอปอ่านยอดเงิน"
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "ใช้เพื่อหาสลิปโอนเงินใหม่ในอัลบั้มของแอปธนาคาร แล้วอ่านยอดเงินให้อัตโนมัติ",
          "savePhotosPermission": "แอปนี้ไม่บันทึกรูปลงเครื่อง",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#F7F1E3"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "411f9986-1fbd-4550-9ee5-12cf46a6c74c"
      }
    }
  }
}
